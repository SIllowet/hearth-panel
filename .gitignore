# Holds your playit agent secret and local server paths — never commit this.
config.json

# Holds your AI provider API key — never commit this either.
ai_config.json

# What the AI remembers about your server and your players.
ai_memory.json

# Runtime junk
panel.log
__pycache__/
*.pyc

# In case anyone keeps a server folder inside the repo
servers/
backups/
*.jar

# Staged update downloads
.update/

# Local safety backups made before edits
*.bak-*

# Browser profile for the app window
.window/

# The tunnel agent is downloaded, never committed
playit.exe
